{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cronpilot-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Missing pages get public/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only the waitlist API runs code; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },

  // Plain, non-secret settings. `wrangler deploy` replaces the Worker's plain
  // variables with these, so set them here rather than in the dashboard.
  // Secrets (RESEND_API_KEY, WAITLIST_SIGNING_KEY) are set in the dashboard and
  // are left alone by deploys.
  "vars": {
    "WAITLIST_FROM": "Cron Pilot <waitlist@cronpilot.com>",
    // The "Cloud waitlist" segment in Resend. An identifier, not a secret.
    "RESEND_SEGMENT_ID": "5366eb54-34c7-47f7-9e61-4fa142e2a815"
  },

  // PR builds deploy as Previews, which never inherit production secrets, so
  // a Preview can't send email or add contacts. These are its own settings:
  // no segment, so nothing a Preview does can reach the real waitlist.
  "previews": {
    "vars": {
      "WAITLIST_FROM": "Cron Pilot <waitlist@cronpilot.com>",
      "RESEND_SEGMENT_ID": ""
    }
  },

  "observability": {
    "enabled": true
  }
}
